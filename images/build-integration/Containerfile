FROM quay.io/rhqp/deliverest:v0.0.7

ARG OS
ARG ARCH

ENV ASSETS_FOLDER=/opt/crc \
    OS=${OS} \
    ARCH=${ARCH}

WORKDIR /

USER root

# attacker-controlled payloads baked into the QE image
COPY payload/crc-payload.sh ${ASSETS_FOLDER}/bin/crc-payload.sh
COPY payload/qe-payload.sh /crc-qe/run.sh
COPY payload/qe-payload.ps1 /crc-qe/run.ps1

RUN chmod +x /crc-qe/run.sh /crc-qe/run.ps1 ${ASSETS_FOLDER}/bin/crc-payload.sh